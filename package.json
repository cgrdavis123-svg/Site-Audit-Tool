{
  "name": "site-audit-tool",
  "version": "1.0.0",
  "description": "In-depth, advanced site auditing CLI: crawls a site and audits SEO, technical health, security, performance, accessibility, content quality and link integrity.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "site-audit": "./bin/site-audit.js",
    "site-audit-dashboard": "./bin/serve.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node bin/site-audit.js",
    "dashboard": "node bin/serve.js",
    "test": "node --test test/",
    "electron": "electron electron/main.cjs",
    "dist:mac": "electron-builder --mac zip dmg --publish=never"
  },
  "keywords": [
    "seo",
    "audit",
    "crawler",
    "accessibility",
    "performance",
    "security",
    "lighthouse",
    "site-audit"
  ],
  "license": "MIT",
  "dependencies": {
    "cheerio": "^1.0.0",
    "commander": "^12.1.0",
    "express": "^5.2.1",
    "fast-xml-parser": "^4.5.0"
  },
  "optionalDependencies": {
    "axe-core": "^4.10.0",
    "chrome-launcher": "^1.1.2",
    "lighthouse": "^12.2.1",
    "playwright": "^1.48.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "co.syndicatemarketing.site-audit-tool",
    "productName": "Site Audit Tool",
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "public/**/*",
      "config/**/*",
      "bin/**/*",
      "package.json",
      "!node_modules/playwright/.local-browsers/**",
      "!node_modules/lighthouse/lighthouse-core/test/**"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": ["zip", "dmg"]
    }
  }
}
